# Server Configuration
PORT=3000
NODE_ENV=development

# AI Service Configuration (Optional - for enhanced analysis)
# Choose one:
OPENAI_API_KEY=sk-...
# OR
ANTHROPIC_API_KEY=sk-ant-...

# Which AI provider to use ('openai' or 'anthropic')
AI_PROVIDER=openai

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (comma-separated list for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=info

# Optional: Database for scan history (future feature)
# MONGODB_URI=mongodb://localhost:27017/phone_scanner
